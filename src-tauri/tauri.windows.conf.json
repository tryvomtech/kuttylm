{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "resources": {
      "resources/llama/": null,
      "resources/llama-windows/": "llama/",
      "resources/windows-redist/": "redist/"
    }
  }
}
